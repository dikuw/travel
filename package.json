{
  "name": "travel",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
    "start": "node server/index.js",
    "build": "npm install --prefix client && npm run build --prefix client",
    "heroku-postbuild": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.13.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
